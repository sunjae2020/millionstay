# =============================================================================
# MillionStay API — per-instance environment template
# =============================================================================
# Copy to `.env` (single-instance dev) or `.env.<instance>` (white-label
# instance) and fill in. NEVER commit the filled copy — only this .example.
# Spec: docs/proposals/WHITELABEL_INSTANCE_SEPARATION.md §1
# Values marked (NEW) are introduced by the white-label externalization work.
# =============================================================================

# ── 1.1 Identity & DB (per instance, SECRET) ─────────────────────────────────
# Instance's OWN Postgres. White-label = separate Supabase project per instance
# (use the session-pooler connection string). API only boots if this + SESSION_SECRET are set.
DATABASE_URL=
SESSION_SECRET=
# Auth secrets — generate UNIQUE values per instance (openssl rand -hex 32).
# Dev falls back to SESSION_SECRET-derived values, but prod must set all three.
JWT_SECRET=
GUEST_JWT_SECRET=
PARTNER_JWT_SECRET=

# ── 1.2 Company identity (per instance, white-label) ─────────────────────────
COMPANY_LEGAL_NAME=MillionStay Pty Ltd
COMPANY_TRADING_NAME=MillionStay
COMPANY_ABN=
COMPANY_PHONE=
COMPANY_ADDRESS=Melbourne, VIC, Australia
SUPPORT_EMAIL=support@example.com
EMAIL_FROM=MillionStay <noreply@contact.example.com>
# Copied on every outbound email (comma-separated). Blank = no copy.
EMAIL_ALWAYS_CC=
EMAIL_LOGO_URL=https://www.example.com/logo.png
# (NEW) Australian-APP privacy contact shown in privacy/DSAR responses.
# Defaults to SUPPORT_EMAIL if unset. See spec §2.2.
PRIVACY_CONTACT_EMAIL=
# (NEW) Seed-admin bootstrap credentials (rotate immediately after first login).
# See spec §2.6 — replaces the hardcoded admin@millionstay.com in seed-admin.ts.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── 1.3 URLs & domains (per instance) ────────────────────────────────────────
PUBLIC_WEB_URL=https://www.example.com
PUBLIC_API_URL=https://api.example.com
PUBLIC_APP_URL=https://admin.example.com
CLIENT_URL=https://www.example.com
WEB_BASE_URL=https://www.example.com
SIGNING_BASE_URL=https://www.example.com
AGENT_PORTAL_URL=https://agent.example.com
OWNER_PORTAL_URL=https://owner.example.com
SERVICE_HOST_PORTAL_URL=https://host.example.com
# CORS allowlist (comma-separated). Replaces the hardcoded *.millionstay.com
# check in app.ts — see spec §2.1.
ALLOWED_ORIGINS=
# (NEW) Root domain for per-slug owner landing sites (lib/vercelDomains.ts).
# See spec §2.5.
ROOT_DOMAIN=example.com

# ── 1.5 Third-party service keys (per instance per §5 decision) ──────────────
# Stripe — PER INSTANCE (each company's own payout account).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Cloudinary — PER INSTANCE (asset + signed-URL isolation, privacy).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Resend — per instance if own sending domain, else shared.
RESEND_API_KEY=
# Anthropic (AI chat / CS translate) — shareable, metered centrally.
ANTHROPIC_API_KEY=
CHAT_MODEL=
CS_TRANSLATE_MODEL=

# ── Provisioning credentials (per-slug domain registration) ──────────────────
# Used to auto-register {slug}.<ROOT_DOMAIN> on Vercel → auto SSL.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
# Chromium path for Puppeteer PDF rendering (set by nixpacks in prod).
PUPPETEER_EXECUTABLE_PATH=

# ── 시스템 로그의 IP 예상 지역 ────────────────────────────────────────────────
# 로그 화면에서 IP 옆에 지역을 보여 주려고 외부 조회 서비스를 부른다. 나가는 것은
# IP 주소뿐이고 결과는 ip_geo_cache 에 캐시된다. 0 으로 두면 조회를 하지 않고
# 캐시에 있는 값만 표시한다.
IP_GEO_LOOKUP=1
IP_GEO_API_URL=https://ipwho.is/{ip}

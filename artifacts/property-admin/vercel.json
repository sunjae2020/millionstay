{
  "framework": "vite",
  "buildCommand": "cd ../.. && pnpm install --filter @workspace/property-admin... --frozen-lockfile && pnpm --filter @workspace/property-admin build",
  "installCommand": "echo 'Skipping default install (handled in buildCommand)'",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://workspaceapi-server-production-ff8e.up.railway.app/api/:path*"
    }
  ]
}

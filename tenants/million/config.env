# =============================================================================
# tenants/million — PRIMARY MillionStay instance (millionstay.com)
# NON-SECRET config. Secrets (DB/JWT/Stripe/…) live in secrets.env (gitignored)
# and in Railway/Vercel; the primary's local secrets are in root .env.local.
# =============================================================================

# ── Brand: EMPTY = brand.css default (#E8621A). Do not fill for the primary. ─
# (A non-empty BRAND_* would fill brand.overrides.css — the pre-commit guard
#  blocks committing that. Primary stays on the default palette.)
BRAND_ORANGE=
BRAND_NAVY=
BRAND_TEAL=
BRAND_CREAM=
BRAND_BURNT=
BRAND_APRICOT=
BRAND_INK=
BRAND_WHITE=
BRAND_FONT_DISPLAY=
BRAND_FONT_SANS=

# ── Frontend identity (VITE_*) ───────────────────────────────────────────────
VITE_APP_NAME=MillionStay
# Multi-currency (blank): each listing shows its own base currency + a converted
# "≈" reference. (MetHeim pins this to KRW.)
VITE_DEFAULT_CURRENCY=
# Logo assets bundled (no override). Company/bank = current app defaults.
VITE_LOGO_MODE=
VITE_LOGO_URL=
VITE_LOGO_MARK_URL=
VITE_FAVICON=
VITE_COMPANY_LEGAL_NAME=MillionStay Pty Ltd
VITE_COMPANY_ABN=12 345 678 901
VITE_COMPANY_CITY=Melbourne, VIC, Australia
VITE_BANK_NAME=Commonwealth Bank of Australia
VITE_BANK_ACCOUNT_NAME=MillionStay Pty Ltd
VITE_BANK_BSB=063-000
VITE_BANK_ACCOUNT_NO=1234 5678

# ── API company identity ─────────────────────────────────────────────────────
COMPANY_LEGAL_NAME=MillionStay Pty Ltd
COMPANY_TRADING_NAME=MillionStay
COMPANY_ABN=12 345 678 901
COMPANY_PHONE=
COMPANY_ADDRESS=Melbourne, VIC, Australia
SUPPORT_EMAIL=millionstay.com@gmail.com
EMAIL_FROM=MillionStay <noreply@contact.millionstay.com>
EMAIL_LOGO_URL=
PRIVACY_CONTACT_EMAIL=privacy@millionstay.com
SEED_ADMIN_EMAIL=admin@millionstay.com

# ── URLs & domains ───────────────────────────────────────────────────────────
ROOT_DOMAIN=millionstay.com
PUBLIC_WEB_URL=https://millionstay.com
PUBLIC_API_URL=https://api.millionstay.com
PUBLIC_APP_URL=https://admin.millionstay.com
CLIENT_URL=https://millionstay.com
WEB_BASE_URL=https://millionstay.com
SIGNING_BASE_URL=https://millionstay.com
AGENT_PORTAL_URL=https://agent.millionstay.com
OWNER_PORTAL_URL=https://owner.millionstay.com
SERVICE_HOST_PORTAL_URL=https://services.millionstay.com

# Frontend (VITE_*) copies — baked into the guest web build so the unified
# partner login (/portal-login) redirects into the correct portal via SSO
# hand-off. (The main millionstay-web build also hardcodes these as defaults.)
VITE_AGENT_PORTAL_URL=https://agent.millionstay.com
VITE_OWNER_PORTAL_URL=https://owner.millionstay.com
VITE_SERVICE_HOST_PORTAL_URL=https://services.millionstay.com
ALLOWED_ORIGINS=https://millionstay.com,https://admin.millionstay.com,https://agent.millionstay.com,https://owner.millionstay.com,https://services.millionstay.com

# ── Non-secret third-party ids (fill from Vercel/Stripe dashboards) ──────────
STRIPE_PUBLISHABLE_KEY=
CLOUDINARY_CLOUD_NAME=
CHAT_MODEL=
CS_TRANSLATE_MODEL=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=team_VD0mxpPcMmO0IXw9XPlwhzyw

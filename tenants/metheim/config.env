# =============================================================================
# tenants/metheim — PILOT 2nd instance (Metheim). Teal brand, text wordmark.
# Locally provisioned + validated; cloud deploy pending (own Railway/Vercel).
# Supabase project: metheim (Seoul, ref dhdjxweuushugqltjael) — SEPARATE from
# primary. DATABASE_URL + all secrets → secrets.env (gitignored).
# =============================================================================

# ── Brand: Metheim "Urban Teal / Night Harbor" palette ───────────────────────
# Single source of truth: tenants/metheim/brand-guidelines.md (v1.0).
# Values are bare HSL triplets ("H S% L%") — generate-brand.mjs maps each
# BRAND_* → a --brand-* primitive in brand.css. Slot NAMES are legacy (from the
# Million orange brand); the mapping below is by ROLE, not by name:
#
#   env slot      brand.css role            Metheim color      HEX
#   BRAND_ORANGE  PRIMARY (--primary)       Urban Teal         #005F73
#   BRAND_NAVY    dark / heading / sidebar  Deep Teal          #00323D
#   BRAND_TEAL    accent (CTA/강조선/아이콘) Logo Gold          #C6942E
#   BRAND_CREAM   warm light background     Cream              #F4EFE1
#   BRAND_BURNT   primary hover / press     Teal 700           #004E5F
#   BRAND_APRICOT tint / tag background     Champagne          #E6D5B8
#   BRAND_INK     body text                 Ink                #12232B
#   BRAND_WHITE   card surface              White              #FFFFFF (default)
#
# Soft Brick #EE9B00 (guideline ≤3% pointer) has no primitive slot — use it as a
# one-off literal where a spark of activity is needed, not as a themed token.
BRAND_ORANGE=190 100% 23%
BRAND_NAVY=190 100% 12%
BRAND_TEAL=40 62% 48%
BRAND_CREAM=44 46% 92%
BRAND_BURNT=190 100% 19%
BRAND_APRICOT=38 48% 81%
BRAND_INK=199 41% 12%
BRAND_WHITE=
# Fonts (guideline §5): Display=Montserrat, Body/UI=Pretendard. Full CSS stacks
# (kept literal, incl. multi-locale Noto fallbacks). NOTE: Montserrat must be
# added to each app's index.html <link> tags at cloud-deploy time — the stack
# only names the family, it does not load the webfont.
BRAND_FONT_DISPLAY="Montserrat", "Pretendard", "Noto Sans JP", "Noto Sans SC", "Noto Sans Thai", ui-sans-serif, system-ui, sans-serif
BRAND_FONT_SANS="Pretendard", "Inter", "Noto Sans JP", "Noto Sans SC", "Noto Sans Thai", ui-sans-serif, system-ui, sans-serif

# ── Frontend identity (VITE_*) ───────────────────────────────────────────────
VITE_APP_NAME=Metheim
# Single-building "development" site variant (Home / Buy / Rent / Management)
# instead of the standard booking marketplace. Serves the 4-part Metheim Yeosu
# site; the shared booking/search/portal routes stay mounted underneath so the
# short-term Rent flow keeps working. See src/lib/site-mode.ts.
VITE_SITE_MODE=development
# Korean is this instance's language: a first-time visitor whose device language
# is not one we support opens in Korean rather than English.
VITE_DEFAULT_LANG=ko
# Single display currency for the guest web (Korea instance → Korean won).
# Pins the guest UI to KRW: default currency = KRW and every listing price is
# shown in ₩ (converted from the listing's base currency via live FX), so a
# guest never sees A$/US$ on a Metheim listing. Unset on MillionStay (per-listing
# native currency + a converted "≈" reference line).
VITE_DEFAULT_CURRENCY=KRW
# Default country written onto new CRM records, in the language the records are
# kept in. Unset on MillionStay → "Australia" (previous behaviour).
VITE_DEFAULT_COUNTRY=대한민국
# Space status option set. Metheim manages a single 분양/임대 building unit-by-unit,
# so the admin Space status uses building-ledger occupancy states
# (임대/대여/분양/공실/임대불가) instead of the platform Active/Inactive/Suspended
# listing lifecycle. Unset on MillionStay → standard lifecycle. See
# artifacts/property-admin/src/lib/spaceStatus.ts.
VITE_SPACE_STATUS_SET=ledger-ko
# Per-instance language-flag overrides (`<lang>:<iso>` pairs). The DB
# languages.flag_iso is shared across instances (English → "au" for the
# Australian MillionStay primary), so Metheim overrides English to the US flag
# purely in the guest bundle. Unset on MillionStay → keeps the Australian flag.
VITE_FLAG_OVERRIDES=en:us
# API base for the guest web (million-stay-web bakes this absolute URL — its
# getApiBase() uses VITE_API_URL for non-millionstay.com hosts, no /api proxy).
# admin + partner portals instead call a same-origin /api that their deploy
# vercel.json rewrites to this same host. Single source of the Metheim API URL.
VITE_API_URL=https://metheim-api-production.up.railway.app
# Brand logos on Cloudinary (primary account, metheim/logos/ folder — swap to a
# Metheim-owned Cloudinary once provisioned). Source SVGs: tenants/metheim/logos/.
VITE_LOGO_MODE=image
VITE_LOGO_URL=https://res.cloudinary.com/dthc3gmdr/image/upload/v1784819834/metheim/logos/metheim-logo-horizontal-teal.svg
VITE_LOGO_MARK_URL=https://res.cloudinary.com/dthc3gmdr/image/upload/v1784819839/metheim/logos/metheim-symbol-teal.svg
VITE_FAVICON=https://res.cloudinary.com/dthc3gmdr/image/upload/v1784819844/metheim/logos/favicon.svg
# Company/bank: TBD for the pilot (defaults to app values until set).
VITE_COMPANY_LEGAL_NAME=
VITE_COMPANY_ABN=
VITE_COMPANY_CITY=
VITE_BANK_NAME=
VITE_BANK_ACCOUNT_NAME=
VITE_BANK_BSB=
VITE_BANK_ACCOUNT_NO=

# ── API company identity (TBD for the pilot) ─────────────────────────────────
# NOTE: the live issuer block on generated documents/emails is driven by
# Settings → Organisation (company_info: company_name / biz_no 사업자등록번호 /
# ceo 대표자 / address …); these env values are only the fallback until the org
# form is filled. COMPANY_CEO backs the document issuer "대표자" line the same way.
COMPANY_LEGAL_NAME=
COMPANY_TRADING_NAME=Metheim
COMPANY_ABN=
COMPANY_CEO=
COMPANY_PHONE=
COMPANY_ADDRESS=
SUPPORT_EMAIL=
# Envelope sender. MUST be on a domain verified with Resend — contact.metheim.com
# is verified (SPF/DKIM/MX, ap-northeast-1). The org contact address
# (metheim.yeosu@gmail.com) can never be the From: Resend rejects free-mail
# domains ("This API key is not authorized to send emails from gmail.com");
# lib/email.ts demotes such a value to Reply-To automatically.
EMAIL_FROM=Metheim <noreply@contact.metheim.com>
EMAIL_LOGO_URL=https://res.cloudinary.com/dthc3gmdr/image/upload/v1784819834/metheim/logos/metheim-logo-horizontal-teal.svg
PRIVACY_CONTACT_EMAIL=
SEED_ADMIN_EMAIL=metheim.yeosu@gmail.com
# Bank-transfer details shown in the guest booking-confirmation email. A Korean
# instance (DEFAULT_CURRENCY=KRW) renders a KR block (은행/예금주/계좌번호). Real
# deposit account = the 신영부동산신탁 trust account (부동산신탁 구조상 예금주가 회사
# 법인명과 다름 → BANK_ACCOUNT_NAME을 명시). MillionStay unset → AU defaults
# (Commonwealth Bank / BSB). See lib/email.ts sendBookingConfirmation.
BANK_NAME=신용협동조합
BANK_ACCOUNT_NAME=신영부동산신탁
BANK_ACCOUNT_NO=131-022-898360

# ── Document theme (generated PDF + email) ───────────────────────────────────
# theme.ts DOC_TOKENS default to MillionStay orange; these override generated
# invoices/quotes/receipts/contracts to the Metheim "Urban Teal" palette
# (design guide docs/tenants/metheim/DESIGN_GUIDE.md §B2). Read from process.env
# at api boot — set these on the Metheim Railway service. Card stays white;
# only brand + neutral/surface tokens shift to the teal-grey scale.
DOC_BRAND=#005F73
DOC_BRAND_HOVER=#004E5F
DOC_INK=#12232B
DOC_INK_MUTED=#566268
DOC_INK_FAINT=#9FABB0
DOC_PAGE_BG=#F1F4F4
DOC_BORDER=#E4E9EA
DOC_ACCENT_BG=#E7F0F1
DOC_ACCENT_BORDER=#B9D2D8
# Body font for documents (Puppeteer render). Noto-first — do NOT add Pretendard
# here (webfont-load failure shifts glyphs in headless Chromium). §B3.
DOC_FONT="Noto Sans KR", "Noto Sans", "Noto Sans JP", "Noto Sans SC", "Noto Sans Thai", -apple-system, sans-serif
# Default document/email language when a request carries no ?lang= (Korea → ko).
# So every Metheim invoice/receipt/quote/contract + cover email renders in Korean
# by default. Unset on MillionStay → English. See lib/documents/i18n.ts.
DEFAULT_DOC_LANG=ko
# Label for the business-registration number in the document issuer block.
# Korea → 사업자등록번호 (paired with company_info.biz_no). Unset → "ABN" (AU).
DOC_REG_LABEL=사업자등록번호
# Tenant-wide default currency for any amount with no explicit currency (blank
# invoice/booking currency, GL postings, document money fallback, sample docs).
# Korea → KRW (₩, 0 decimals). Unset on MillionStay → AUD. See lib/currency.ts.
DEFAULT_CURRENCY=KRW

# ── URLs & domains (TBD — set when cloud deploy lands) ───────────────────────
ROOT_DOMAIN=
PUBLIC_WEB_URL=
PUBLIC_API_URL=https://metheim-api-production.up.railway.app
PUBLIC_APP_URL=
CLIENT_URL=
WEB_BASE_URL=
SIGNING_BASE_URL=
AGENT_PORTAL_URL=https://metheim-agent.vercel.app
OWNER_PORTAL_URL=https://metheim-owner.vercel.app
SERVICE_HOST_PORTAL_URL=https://metheim-host.vercel.app
# CORS allow-list for the API. Metheim has no apex ROOT_DOMAIN yet (frontends live
# on *.vercel.app, which the apex/subdomain trust in app.ts does NOT cover), so
# every browser origin that calls the API must be listed explicitly: guest web,
# admin, and the three partner portals. The unified partner login on the guest
# web (/portal-login) POSTs to /api/v1/auth/partner/login cross-origin, so
# metheim-web must be present too. Keep in sync with the *_PORTAL_URL values.
ALLOWED_ORIGINS=https://metheim-web.vercel.app,https://metheim-admin.vercel.app,https://metheim-agent.vercel.app,https://metheim-owner.vercel.app,https://metheim-host.vercel.app

# Frontend (VITE_*) copies of the partner-portal origins — baked into the guest
# web build so the unified partner login (/portal-login) redirects into the
# correct portal via SSO hand-off. Mirror the backend *_PORTAL_URL values above.
# Public site host — used by the CMS site registry (scripts/seed-cms-sites.mjs).
# VERCEL_WEB_PROJECT_ID / VERCEL_TEAM_ID are what the API needs to auto-register
# a custom address set in CMS -> Pages -> site settings (set them on the API
# host too, alongside VERCEL_TOKEN).
# VERCEL_WEB_PROJECT_ID=prj_Y6wENY6MkwtUDlLcbCVdjoLprzA5  (metheim-web)
# VERCEL_TEAM_ID=sunjae2020s-projects
VITE_PUBLIC_WEB_URL=https://metheim-web.vercel.app

VITE_AGENT_PORTAL_URL=https://metheim-agent.vercel.app
VITE_OWNER_PORTAL_URL=https://metheim-owner.vercel.app
VITE_SERVICE_HOST_PORTAL_URL=https://metheim-host.vercel.app

# ── Non-secret third-party ids (per-instance Stripe/Cloudinary) ──────────────
STRIPE_PUBLISHABLE_KEY=
CLOUDINARY_CLOUD_NAME=
CHAT_MODEL=
CS_TRANSLATE_MODEL=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Listing price period: month → cards show "₩… / 월" (Metheim 월 단위 임대).
VITE_PRICE_UNIT=month

# App-wide date format for the guest web + partner portals (Korea → YYYY/MM/DD).
# Baked into each frontend build; matches admin Settings → Organisation → Date
# format (branding_settings.date_format = YYYY/MM/DD), which drives the admin UI
# and every generated document (invoice/receipt/contract) at runtime. Unset on
# MillionStay → default DD/MM/YYYY (AU). See src/lib/dateFormat.ts. Options:
# DD/MM/YYYY | MM/DD/YYYY | YYYY-MM-DD | YYYY/MM/DD | D MMM YYYY.
VITE_DATE_FORMAT=YYYY/MM/DD

# Owner portal: Metheim owners are building unit owners (ledger model), not
# marketplace hosts, so the per-owner landing site + inquiries module is hidden
# (nav entries, /site + /inquiries routes, dashboard promo/inquiry widgets).
VITE_OWNER_SITE_ENABLED=false

# ── 광고성 정보 발송 (정보통신망법 제50조) ──────────────────────────────────
# Metheim 은 한국 법인이라 광고 메일에 세 가지 의무가 더 붙는다. 이 값이 없으면
# 코드는 호주 Spam Act 요건(동의·수신거부)만 지키고 아래는 동작하지 않는다.
#   ④ 제목 머리에 광고 표기          → MARKETING_AD_PREFIX
#   ④ 야간(21–08시) 광고 발송 금지    → MARKETING_QUIET_HOURS + MARKETING_TZ
# 수신동의 출처·시점 고지는 DEFAULT_DOC_LANG=ko 로 한국어 푸터가 자동 적용된다.
MARKETING_AD_PREFIX=(광고)
MARKETING_QUIET_HOURS=21-08
MARKETING_TZ=Asia/Seoul

# ── SMS 발송 (SOLAPI) ────────────────────────────────────────────────────────
# 개통 절차: docs/SMS_SOLAPI_SETUP.md
# 값이 비어 있으면 sendSms() 가 skipped 를 돌려주고 아무것도 보내지 않는다.
# API 키·시크릿은 레포에 넣지 않는다 — Railway 환경변수로만 설정한다.
#   SOLAPI_API_KEY, SOLAPI_API_SECRET
#
# 발신번호(사전등록제). 승인된 번호만 발신 가능.
SMS_SENDER_NUMBER=
# 광고 SMS 무료거부 080 번호. **비어 있으면 광고성 SMS 는 발송을 거부한다**
# (정보통신망법 — 링크로 대체 불가). 거래성 SMS 는 이 값 없이도 나간다.
SMS_AD_OPT_OUT_NUMBER=
#
# 카카오 알림톡 발신프로필 키. 채널을 개설하고 Solapi 에 연동하면 발급된다.
# 비어 있으면 알림톡을 시도하지 않고 SMS 로만 나간다(발송이 멈추지는 않는다).
# 템플릿별 templateId 는 env 가 아니라 DB 에 둔다 —
#   node scripts/set-kakao-template-id.mjs <키> <templateId>
KAKAO_PF_ID=

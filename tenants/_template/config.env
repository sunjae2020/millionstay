# =============================================================================
# tenants/<name>/config.env — NON-SECRET per-tenant configuration (committed)
# =============================================================================
# Copy to tenants/<name>/config.env and fill. Secrets go in secrets.env (gitignored).
# Consumed by: scripts/provision-instance.sh (TENANT=<name>), Railway API vars,
# Vercel frontend env. See tenants/README.md.
# =============================================================================

# ── Brand palette (build-time → generate-brand.mjs → brand.overrides.css) ────
# HSL triplets "H S% L%" (match brand.css). Leave EMPTY for the primary
# MillionStay palette (#E8621A). BRAND_ORANGE is the PRIMARY slot.
BRAND_ORANGE=
BRAND_NAVY=
BRAND_TEAL=
BRAND_CREAM=
BRAND_BURNT=
BRAND_APRICOT=
BRAND_INK=
BRAND_WHITE=
# Optional full CSS font-family stacks.
BRAND_FONT_DISPLAY=
BRAND_FONT_SANS=

# ── Frontend identity (VITE_*, baked into the client bundle) ─────────────────
VITE_APP_NAME=
VITE_API_URL=
# Pin the guest web to a single display currency (ISO code, e.g. KRW). When set,
# the guest UI defaults to it and shows every listing price in it (converted from
# the listing's base currency via live FX). Leave blank for multi-currency
# (per-listing native currency + a converted "≈" reference).
VITE_DEFAULT_CURRENCY=
# Logos: URL, or set VITE_LOGO_MODE=text for a styled text wordmark (no asset).
VITE_LOGO_MODE=
VITE_LOGO_URL=
VITE_LOGO_MARK_URL=
VITE_FAVICON=
# Legal/bank shown on receipts, payment, policy (non-secret payment coordinates).
VITE_COMPANY_LEGAL_NAME=
VITE_COMPANY_ABN=
VITE_COMPANY_CITY=
VITE_BANK_NAME=
VITE_BANK_ACCOUNT_NAME=
VITE_BANK_BSB=
VITE_BANK_ACCOUNT_NO=

# ── API company identity (non-secret) ────────────────────────────────────────
COMPANY_LEGAL_NAME=
COMPANY_TRADING_NAME=
COMPANY_ABN=
COMPANY_PHONE=
COMPANY_ADDRESS=
SUPPORT_EMAIL=
EMAIL_FROM=
EMAIL_LOGO_URL=
PRIVACY_CONTACT_EMAIL=
SEED_ADMIN_EMAIL=

# ── URLs & domains (non-secret) ──────────────────────────────────────────────
ROOT_DOMAIN=
PUBLIC_WEB_URL=
PUBLIC_API_URL=
PUBLIC_APP_URL=
CLIENT_URL=
WEB_BASE_URL=
SIGNING_BASE_URL=
AGENT_PORTAL_URL=
OWNER_PORTAL_URL=
SERVICE_HOST_PORTAL_URL=
ALLOWED_ORIGINS=

# ── Non-secret third-party ids ───────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=
CLOUDINARY_CLOUD_NAME=
CHAT_MODEL=
CS_TRANSLATE_MODEL=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

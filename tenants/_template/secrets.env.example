# =============================================================================
# tenants/<name>/secrets.env — SECRET per-tenant values (GITIGNORED)
# =============================================================================
# Copy to tenants/<name>/secrets.env and fill. NEVER commit the filled file
# (tenants/*/secrets.env is gitignored). Generate auth secrets per instance:
#   openssl rand -hex 32
# =============================================================================

# ── Database (instance's OWN Supabase — session-pooler URL, port 5432) ───────
# Provisioner refuses the primary/production project ref (see provision-instance.sh).
DATABASE_URL=

# ── Auth secrets (UNIQUE per instance) ───────────────────────────────────────
SESSION_SECRET=
JWT_SECRET=
GUEST_JWT_SECRET=
PARTNER_JWT_SECRET=

# ── Seed admin bootstrap (rotate after first login) ──────────────────────────
SEED_ADMIN_PASSWORD=

# ── Stripe (per instance — own payout account) ───────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Cloudinary (per instance — asset + signed-URL isolation) ─────────────────
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / AI ───────────────────────────────────────────────────────────────
RESEND_API_KEY=
ANTHROPIC_API_KEY=

# ── Provisioning credential (per-slug Vercel domain registration) ────────────
VERCEL_TOKEN=
